API_KEY=your-openai-api-key-here


# Voice input (optional): set to true to speak your turns instead of typing
# them. Uses OpenAI's Whisper API to transcribe a fixed-length recording
# from the default microphone. Requires `pip install sounddevice scipy`.
VOICE_INPUT=false
WHISPER_MODEL=whisper-1
VOICE_INPUT_DURATION=5

# Voice output (optional): set to true to have the assistant read each reply
# aloud with OpenAI text-to-speech (the reply is still printed too). No extra
# packages needed; plays through the system's default speakers. Use the SAME
# voice and instructions for every profile so only the words differ.
VOICE_OUTPUT=false
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
TTS_INSTRUCTIONS=Speak clearly at a steady, natural pace in a neutral tone.
